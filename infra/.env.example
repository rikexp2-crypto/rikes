# Copie este arquivo para infra/.env e preencha com valores reais.
# NUNCA commitar o arquivo .env com segredos reais.

# --- Postgres ---
POSTGRES_USER=rikes_admin
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=rikes_crm
CHATWOOT_DB=chatwoot_production

# --- n8n ---
N8N_HOST=n8n.suaempresa.com.br
N8N_ENCRYPTION_KEY=gere_uma_chave_aleatoria_de_32_chars

# --- Chatwoot ---
CHATWOOT_HOST=atendimento.suaempresa.com.br
CHATWOOT_SECRET_KEY_BASE=gere_com_openssl_rand_-hex_64

# --- Meta / WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# --- Instagram Messaging API ---
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Grafica Plus: SEM API/Webhook (confirmado) ---
