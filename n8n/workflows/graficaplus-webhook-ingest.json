{
  "name": "Graficaplus - Webhook Ingest",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/graficaplus",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "1a1b1c1d-0001-4000-8000-000000000001",
      "name": "Webhook - Graficaplus",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "graficaplus-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o payload recebido do Graficaplus para o formato interno.\n// Ajustar os caminhos (item.json.body.xxx) assim que o formato real do\n// webhook/API do Graficaplus for confirmado.\nconst body = $input.item.json.body;\n\nconst telefone = (body.cliente?.telefone || '').replace(/\\D/g, '');\nconst telefoneE164 = telefone.startsWith('55') ? `+${telefone}` : `+55${telefone}`;\n\nreturn {\n  json: {\n    event: body.event,\n    cliente: {\n      nome: body.cliente?.nome || null,\n      telefone: telefoneE164,\n      email: body.cliente?.email || null,\n      instagram: body.cliente?.instagram || null\n    },\n    pedido: {\n      id: body.pedido?.id || null,\n      produto: body.pedido?.produto || null,\n      tiragem: body.pedido?.tiragem || null,\n      valor: body.pedido?.valor || null,\n      status: body.pedido?.status || null\n    },\n    origem: {\n      utm_source: body.origem?.utm_source || null,\n      ctwa_clid: body.origem?.ctwa_clid || null\n    },\n    timestamp: body.timestamp || new Date().toISOString()\n  }\n};"
      },
      "id": "1a1b1c1d-0002-4000-8000-000000000002",
      "name": "Normalizar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT find_or_create_contact('site'::channel_type, $1, NULL, $2) AS contact_id",
        "options": {
          "queryReplacement": "={{ [$json.cliente.telefone || $json.cliente.email, $json.cliente.email] }}"
        }
      },
      "id": "1a1b1c1d-0003-4000-8000-000000000003",
      "name": "Postgres - Find/Create Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [640, 300],
      "credentials": {
        "postgres": { "id": "rikes-postgres", "name": "Rikes Postgres" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO graficaplus_events (event_type, raw_payload, contact_id, processed, processed_at) VALUES ($1, $2, $3, TRUE, now())",
        "options": {
          "queryReplacement": "={{ [$('Normalizar Payload').item.json.event, JSON.stringify($('Normalizar Payload').item.json), $json.contact_id] }}"
        }
      },
      "id": "1a1b1c1d-0004-4000-8000-000000000004",
      "name": "Postgres - Log Evento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [860, 220],
      "credentials": {
        "postgres": { "id": "rikes-postgres", "name": "Rikes Postgres" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $('Normalizar Payload').item.json.event }}",
              "rightValue": "status_alterado",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a1b1c1d-0005-4000-8000-000000000005",
      "name": "IF - Status Alterado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 380]
    },
    {
      "parameters": {
        "url": "={{ 'https://graph.facebook.com/v20.0/' + $env.WHATSAPP_PHONE_NUMBER_ID + '/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  messaging_product: 'whatsapp',\n  to: $('Normalizar Payload').item.json.cliente.telefone.replace('+',''),\n  type: 'text',\n  text: { body: `Seu pedido #${$('Normalizar Payload').item.json.pedido.id} mudou de status: ${$('Normalizar Payload').item.json.pedido.status}` }\n} }}"
      },
      "id": "1a1b1c1d-0006-4000-8000-000000000006",
      "name": "WhatsApp - Notificar Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 340],
      "credentials": {
        "httpHeaderAuth": { "id": "whatsapp-cloud-api-token", "name": "WhatsApp Cloud API Token" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO deals (contact_id, produto, tiragem, valor_estimado, graficaplus_pedido_id, stage)\nVALUES ($1, $2, $3, $4, $5,\n  CASE $6\n    WHEN 'novo_pedido' THEN 'lead_novo'\n    WHEN 'novo_orcamento' THEN 'orcamento_enviado'\n    ELSE 'lead_novo'\n  END)\nON CONFLICT (graficaplus_pedido_id) DO UPDATE SET\n  valor_estimado = EXCLUDED.valor_estimado,\n  updated_at = now()",
        "options": {
          "queryReplacement": "={{ [$json.contact_id, $('Normalizar Payload').item.json.pedido.produto, $('Normalizar Payload').item.json.pedido.tiragem, $('Normalizar Payload').item.json.pedido.valor, $('Normalizar Payload').item.json.pedido.id, $('Normalizar Payload').item.json.event] }}"
        }
      },
      "id": "1a1b1c1d-0007-4000-8000-000000000007",
      "name": "Postgres - Upsert Deal (Kanban)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [860, 500],
      "credentials": {
        "postgres": { "id": "rikes-postgres", "name": "Rikes Postgres" }
      }
    }
  ],
  "connections": {
    "Webhook - Graficaplus": {
      "main": [[{ "node": "Normalizar Payload", "type": "main", "index": 0 }]]
    },
    "Normalizar Payload": {
      "main": [[
        { "node": "Postgres - Find/Create Contact", "type": "main", "index": 0 }
      ]]
    },
    "Postgres - Find/Create Contact": {
      "main": [[
        { "node": "Postgres - Log Evento", "type": "main", "index": 0 },
        { "node": "IF - Status Alterado?", "type": "main", "index": 0 },
        { "node": "Postgres - Upsert Deal (Kanban)", "type": "main", "index": 0 }
      ]]
    },
    "IF - Status Alterado?": {
      "main": [[
        { "node": "WhatsApp - Notificar Status", "type": "main", "index": 0 }
      ], []]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
